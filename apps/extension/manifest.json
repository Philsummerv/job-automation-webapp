{
  "manifest_version": 3,
  "name": "JobAssistUI",
  "version": "1.0.0",
  "description": "Guided autofill for job-application forms, driven by your saved answer template.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://*.indeed.com/*",
    "https://jobassistui.com/*",
    "https://www.jobassistui.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.indeed.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobassistui.com/*",
        "https://www.jobassistui.com/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
